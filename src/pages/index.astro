---
import "../../src/styles/global.css";
---

<!doctype html>
<html lang="id" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- SEO Meta Tags -->
        <title>
            Mindguard: Melindungi Kesehatan Mental dari Manipulasi Algoritma
        </title>
        <meta
            name="description"
            content="Platform edukasi psikologis dan audit dampak algoritma media sosial terhadap sirkuit dopamin dan kesehatan mental remaja."
        />
        <meta
            name="keywords"
            content="Mindguard, Kesehatan Mental, Psikologi, Dopamin, Adiksi Digital, Kurzgesagt, Harvard STRIPED, Michigan State University"
        />
        <meta name="author" content="Mindguard Team" />

        <!-- Google Fonts for Kurzgesagt Theme (Rounded and Friendly Headings, readable body) -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300..700&family=Nunito:wght@300..900&display=swap"
            rel="stylesheet"
        />

        <style is:global>
            :root {
                --sage-green: #f0f4f1;
                --deep-teal: #1e3e3f;
                --coral-accent: #ee6c81;
                --coral-soft: #f3a3b1;
                --yellow-muted: #f5c564;
                --mint-green: #8ae3c2;
                --mint-soft: #a7f3d0;
                --cream-card: #fffdf9;
            }

            body {
                background-color: var(--sage-green);
                color: var(--deep-teal);
                font-family: "Nunito", sans-serif;
                overflow-x: hidden;
            }

            .font-fredoka {
                font-family: "Fredoka", sans-serif;
            }

            /* Beautiful Organic Blobs for Kurzgesagt biological style */
            .organic-blob-1 {
                background-color: rgba(138, 227, 194, 0.12);
                border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
            }

            .organic-blob-2 {
                background-color: rgba(243, 163, 177, 0.1);
                border-radius: 50% 50% 30% 70% / 50% 60% 40% 50%;
            }

            .organic-blob-3 {
                background-color: rgba(245, 197, 100, 0.1);
                border-radius: 60% 40% 60% 40% / 50% 40% 60% 50%;
            }

            /* Custom Cursor Styling */
            #cursor-custom {
                position: fixed;
                top: 0;
                left: 0;
                width: 36px;
                height: 36px;
                margin-top: -18px;
                margin-left: -18px;
                pointer-events: none;
                z-index: 10000;
                display: none;
                transition: transform 0.04s ease-out;
            }

            @media (min-width: 1024px) {
                body {
                    cursor: none;
                }
                #cursor-custom {
                    display: block;
                }
                a,
                button,
                input,
                select,
                textarea,
                [role="button"],
                iframe,
                .interactive-element {
                    cursor: none;
                }
            }

            /* Scrollbar in soft sage/teal */
            ::-webkit-scrollbar {
                width: 12px;
                height: 12px;
            }
            ::-webkit-scrollbar-track {
                background: var(--sage-green);
            }
            ::-webkit-scrollbar-thumb {
                background: var(--deep-teal);
                border-radius: 9999px;
                border: 3px solid var(--sage-green);
            }
            ::-webkit-scrollbar-thumb:hover {
                background: var(--coral-accent);
            }

            /* Infinite Scrolling Marquee for mental health reflections */
            @keyframes scroll-ticker {
                0% {
                    transform: translateX(0);
                }
                100% {
                    transform: translateX(-50%);
                }
            }
            .ticker-track {
                display: flex;
                width: max-content;
                animation: scroll-ticker 30s linear infinite;
            }

            /* Smooth fade-in blur micro-animation */
            @keyframes blurIn {
                0% {
                    filter: blur(12px);
                    opacity: 0;
                    transform: scale(0.96);
                }
                100% {
                    filter: blur(0);
                    opacity: 1;
                    transform: scale(1);
                }
            }
            .animate-blur-in {
                animation: blurIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }
        </style>
    </head>
    <body
        class="min-h-screen relative flex flex-col justify-between selection:bg-[#F3A3B1] selection:text-slate-900"
    >
        <!-- ORGANIC PASTEL BLOBS FOR BIOLOGY AESTHETIC -->
        <div
            class="absolute top-[8%] left-[2%] w-[45vw] h-[45vw] organic-blob-1 pointer-events-none -z-10"
        >
        </div>
        <div
            class="absolute top-[42%] right-[2%] w-[48vw] h-[48vw] organic-blob-2 pointer-events-none -z-10"
        >
        </div>
        <div
            class="absolute bottom-[8%] left-[15%] w-[40vw] h-[40vw] organic-blob-3 pointer-events-none -z-10"
        >
        </div>

        <!-- CUSTOM CURSOR -->
        <div id="cursor-custom" class="pointer-events-none">
            <!-- Injected dynamically by JS (Butterfly default, Hand hover) -->
        </div>

        <!-- HEADER & NAVIGATION -->
        <header
            class="border-b border-slate-200/80 bg-white/70 sticky top-0 z-40 backdrop-blur-md"
        >
            <div
                class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row justify-between items-center gap-4"
            >
                <!-- Brand Logo -->
                <div class="flex items-center gap-3">
                    <!-- Flat Vector SVG: Brain with plants and blooming flowers -->
                    <div
                        class="w-12 h-12 flex items-center justify-center relative group"
                    >
                        <svg
                            viewBox="0 0 100 100"
                            class="w-full h-full transform group-hover:scale-105 transition-transform duration-300"
                        >
                            <circle
                                cx="50"
                                cy="54"
                                r="38"
                                fill="#FFFDF9"
                                stroke="#1E3E3F"
                                stroke-width="3"></circle>
                            <!-- Brain -->
                            <path
                                d="M42 42 C34 42, 32 48, 38 52 C32 54, 34 64, 42 64 C45 64, 47 61, 50 61 C53 61, 55 64, 58 64 C66 64, 68 54, 62 52 C68 48, 66 42, 58 42 C55 42, 53 45, 50 45 C47 45, 45 42, 42 42 Z"
                                fill="#F3A3B1"
                                stroke="#1E3E3F"
                                stroke-width="2.5"></path>
                            <!-- Plant growing out -->
                            <path
                                d="M50 42 Q 47 30, 52 22"
                                fill="none"
                                stroke="#1E3E3F"
                                stroke-width="2"
                                stroke-linecap="round"></path>
                            <path
                                d="M52 22 C55 22, 58 20, 55 17 C52 14, 50 19, 52 22 Z"
                                fill="#8AE3C2"
                                stroke="#1E3E3F"
                                stroke-width="1.5"></path>
                            <path
                                d="M48 30 C44 30, 42 27, 45 25 C48 23, 50 28, 48 30 Z"
                                fill="#8AE3C2"
                                stroke="#1E3E3F"
                                stroke-width="1.5"></path>
                        </svg>
                    </div>
                    <div>
                        <h1
                            class="font-fredoka font-bold text-2xl tracking-wide text-[#1E3E3F]"
                        >
                            Mindguard
                        </h1>
                        <p
                            class="text-xs font-nunito tracking-wide text-slate-500 font-semibold"
                        >
                            Ruang Proteksi &amp; Pemulihan Mental Remaja
                        </p>
                    </div>
                </div>

                <!-- SPA Pill Tabs -->
                <nav
                    class="flex items-center gap-1.5 bg-slate-100 p-1.5 rounded-full border border-slate-200/60 shadow-inner"
                >
                    <button
                        id="tab-btn-home"
                        data-tab="home"
                        class="nav-tab-btn px-5 py-2 rounded-full font-fredoka text-sm font-bold tracking-wide transition-all duration-300 bg-[#1E3E3F] text-white"
                    >
                        🌱 Mindguard Home
                    </button>
                    <button
                        id="tab-btn-database"
                        data-tab="database"
                        class="nav-tab-btn px-5 py-2 rounded-full font-fredoka text-sm font-bold tracking-wide transition-all duration-300 text-slate-600 hover:text-[#1E3E3F] hover:bg-white/60"
                    >
                        📊 Data Hub
                    </button>
                    <button
                        id="tab-btn-scanning"
                        data-tab="scanning"
                        class="nav-tab-btn px-5 py-2 rounded-full font-fredoka text-sm font-bold tracking-wide transition-all duration-300 text-slate-600 hover:text-[#1E3E3F] hover:bg-white/60"
                    >
                        🧠 Digital Audit
                    </button>
                </nav>
            </div>
        </header>

        <!-- MAIN SPA CONTENT GRID -->
        <main
            class="flex-grow max-w-6xl w-full mx-auto px-4 py-8 sm:py-12 md:py-16"
        >
            <!-- ==========================================
        SECTION A: HOME VIEW (Mindguard Home)
        ========================================== -->
            <section
                id="view-home"
                class="spa-view block transition-opacity duration-300"
            >
                <div
                    class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16"
                >
                    <div class="lg:col-span-7 space-y-6">
                        <div
                            class="inline-flex items-center gap-2 px-4 py-2 border border-slate-200 bg-[#8AE3C2]/20 rounded-full text-[#1E3E3F] font-fredoka text-sm font-bold shadow-sm"
                        >
                            <span
                                class="inline-block w-2.5 h-2.5 rounded-full bg-[#8AE3C2] animate-pulse"
                            ></span>
                            Psikologi Digital vs Manipulasi Adiksi
                        </div>

                        <h2
                            class="font-fredoka text-4xl sm:text-5xl md:text-6xl font-extrabold text-[#1E3E3F] leading-tight"
                        >
                            Melindungi Pikiran di <br
                                class="hidden sm:inline"
                            />
                            <span
                                class="text-[#EE6C81] underline decoration-wavy decoration-[#8AE3C2]"
                                >Era Manipulasi Digital</span
                            >
                        </h2>

                        <p
                            class="text-slate-600 text-lg sm:text-xl max-w-xl leading-relaxed"
                        >
                            Menjelajahi bagaimana algoritma media sosial
                            mengeksploitasi celah psikologis dan dopamin remaja,
                            serta langkah nyata mengembalikan kedamaian mental
                            Anda.
                        </p>

                        <div class="flex flex-wrap gap-4 pt-4">
                            <button
                                onclick="document.getElementById('tab-btn-scanning').click();"
                                class="px-8 py-4 bg-[#1E3E3F] text-white hover:bg-[#2A5455] font-fredoka text-md font-bold rounded-3xl transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 shadow-md"
                            >
                                🧠 Ikuti Digital Risk Audit
                            </button>
                            <button
                                onclick="document.getElementById('tab-btn-database').click();"
                                class="px-8 py-4 bg-[#FFFDF9] text-[#1E3E3F] hover:bg-slate-50 font-fredoka text-md font-bold rounded-3xl border border-slate-200 transition-all duration-300 hover:shadow-md hover:-translate-y-0.5 active:translate-y-0 shadow-sm"
                            >
                                📊 Lihat Data Penelitian
                            </button>
                        </div>
                    </div>

                    <div class="lg:col-span-5 flex justify-center">
                        <div
                            class="bg-[#FFFDF9] rounded-[2.5rem] border border-slate-200 p-8 shadow-[0_12px_40px_rgba(0,0,0,0.03)] w-full max-w-md overflow-hidden space-y-6"
                        >
                            <div
                                class="h-48 rounded-2xl overflow-hidden relative border border-slate-100"
                            >
                                <svg
                                    viewBox="0 0 200 120"
                                    class="w-full h-full"
                                >
                                    <rect
                                        width="200"
                                        height="120"
                                        fill="#FAF5FF"></rect>
                                    <circle
                                        cx="100"
                                        cy="75"
                                        r="22"
                                        fill="#F5C564"
                                        opacity="0.8"></circle>
                                    <path
                                        d="M-10 120 Q 50 85, 110 102 T 210 120 Z"
                                        fill="#E2ECE9"></path>
                                    <path
                                        d="M-10 120 Q 75 92, 140 105 T 210 120 Z"
                                        fill="#D2E4E0"
                                        opacity="0.9"></path>
                                    <path
                                        d="M40 120 Q 100 98, 160 106 T 210 120 Z"
                                        fill="#8AE3C2"
                                        opacity="0.6"></path>
                                    <circle
                                        cx="72"
                                        cy="104"
                                        r="2.5"
                                        fill="#EE6C81"></circle>
                                    <path
                                        d="M72 104 L72 109"
                                        stroke="#1E3E3F"
                                        stroke-width="1"></path>
                                    <circle
                                        cx="128"
                                        cy="107"
                                        r="3"
                                        fill="#F3A3B1"></circle>
                                    <path
                                        d="M128 107 L128 111"
                                        stroke="#1E3E3F"
                                        stroke-width="1"></path>
                                    <g transform="translate(100, 92)">
                                        <circle
                                            cx="0"
                                            cy="-9"
                                            r="3.5"
                                            fill="#1E3E3F"></circle>
                                        <path
                                            d="M-5 2 C-2 -4, 2 -4, 5 2 Z"
                                            fill="#1E3E3F"></path>
                                        <ellipse
                                            cx="0"
                                            cy="3"
                                            rx="7"
                                            ry="2.2"
                                            fill="#1E3E3F"></ellipse>
                                    </g>
                                </svg>
                            </div>
                            <div class="space-y-2">
                                <h4
                                    class="font-fredoka text-lg font-bold text-[#1E3E3F]"
                                >
                                    Menemukan Kedamaian Mental
                                </h4>
                                <p
                                    class="text-xs text-slate-500 font-semibold leading-relaxed"
                                >
                                    Ketika kita belajar membatasi asupan umpan
                                    balik instan algoritma, sistem saraf kita
                                    memiliki waktu untuk rileks, meregulasi
                                    kortisol, dan memulihkan kadar serotonin
                                    alami.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="space-y-8">
                    <div class="text-center sm:text-left space-y-1">
                        <h3
                            class="font-fredoka text-3xl font-extrabold text-[#1E3E3F] flex items-center justify-center sm:justify-start gap-2"
                        >
                            <span>👥</span> Kisah Perjalanan &amp; Hambatan Psikologis
                            Remaja
                        </h3>
                        <p
                            class="text-md text-slate-500 font-semibold max-w-3xl leading-relaxed"
                        >
                            Di balik angka dan statistik, terdapat jiwa-jiwa
                            muda yang rentan terhadap manipulasi hormon. Berikut
                            adalah studi kasus psikologis tentang bagaimana
                            adiksi sirkuit otak dibentuk secara tidak sadar.
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div
                            class="bg-[#FFFDF9] rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-[0_8px_30px_rgb(0,0,0,0.03)] hover:shadow-[0_12px_40px_rgb(0,0,0,0.06)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between relative group overflow-hidden"
                        >
                            <div
                                class="absolute top-0 left-0 w-full h-1.5 bg-[#F3A3B1]"
                            >
                            </div>

                            <div class="space-y-5">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <span
                                            class="text-xs font-bold font-fredoka text-[#EE6C81] tracking-wider uppercase"
                                            >Perspektif Klinis // Alexis Spence</span
                                        >
                                        <h4
                                            class="font-fredoka text-2xl font-bold text-[#1E3E3F] mt-1"
                                        >
                                            Alexis Spence
                                        </h4>
                                    </div>
                                    <span
                                        class="bg-[#F3A3B1]/20 text-[#EE6C81] text-[11px] font-fredoka font-bold px-3 py-1 rounded-full border border-[#F3A3B1]/40"
                                        >Body Image Dysmorphia</span
                                    >
                                </div>

                                <p
                                    class="text-slate-600 text-sm sm:text-md leading-relaxed"
                                >
                                    Alexis terpapar algoritma media sosial sejak
                                    usia 11 tahun. Sistem rekomendasi mendeteksi
                                    kerentanan emosinya dan membombardirnya
                                    dengan konten diet ekstrem secara konstan
                                    demi meningkatkan durasi layar. Ini
                                    mengganggu sirkuit dopaminnya, memicu obsesi
                                    negatif terhadap penampilan fisik, kecemasan
                                    kronis, hingga anoreksia parah.
                                </p>

                                <div
                                    class="bg-[#F0F4F1]/60 border border-slate-100 p-4 rounded-2xl space-y-2 relative"
                                >
                                    <div
                                        class="text-[#1E3E3F] font-fredoka font-bold text-xs flex items-center gap-2"
                                    >
                                        <span>🔒</span> Penyamaran Aplikasi &amp;
                                        Gejala Kecanduan
                                    </div>
                                    <p
                                        class="text-slate-600 text-xs leading-relaxed"
                                    >
                                        Alexis menyembunyikan media sosialnya
                                        dalam aplikasi berkamuflase ikon
                                        "Kalkulator". Ini adalah wujud mekanisme
                                        pertahanan diri psikologis remaja
                                        (covert behavior) demi melindungi sumber
                                        dopaminnya dari pembatasan orang tua,
                                        mengindikasikan tingkat ketergantungan
                                        yang setara dengan adiksi klinis.
                                    </p>
                                </div>
                            </div>

                            <div class="pt-6">
                                <button
                                    data-case="alexis"
                                    class="case-expand-btn w-full py-3.5 bg-[#F0F4F1] hover:bg-[#E2ECE9] text-[#1E3E3F] border border-slate-200 font-fredoka text-xs font-bold uppercase rounded-2xl transition-all duration-200"
                                >
                                    Pelajari Perjalanan Alexis ➔
                                </button>
                            </div>
                        </div>

                        <div
                            class="bg-[#FFFDF9] rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-[0_8px_30px_rgb(0,0,0,0.03)] hover:shadow-[0_12px_40px_rgb(0,0,0,0.06)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between relative group overflow-hidden"
                        >
                            <div
                                class="absolute top-0 left-0 w-full h-1.5 bg-[#8AE3C2]"
                            >
                            </div>

                            <div class="space-y-5">
                                <div class="flex justify-between items-start">
                                    <div>
                                        <span
                                            class="text-xs font-bold font-fredoka text-[#0D9488] tracking-wider uppercase"
                                            >Perspektif Klinis // Selena
                                            Rodriguez</span
                                        >
                                        <h4
                                            class="font-fredoka text-2xl font-bold text-[#1E3E3F] mt-1"
                                        >
                                            Selena Rodriguez
                                        </h4>
                                    </div>
                                    <span
                                        class="bg-[#8AE3C2]/20 text-[#0D9488] text-[11px] font-fredoka font-bold px-3 py-1 rounded-full border border-[#8AE3C2]/40"
                                        >Dopamine Hijacking</span
                                    >
                                </div>

                                <p
                                    class="text-slate-600 text-sm sm:text-md leading-relaxed"
                                >
                                    Selena (11 tahun) terperangkap dalam
                                    lingkaran umpan balik visual (likes &amp;
                                    followers) selama pandemi. Algoritma
                                    mengeksploitasi kebutuhan otaknya akan
                                    validasi sosial. Ketika waktu tidurnya
                                    terganggu oleh gulir tanpa batas (infinite
                                    scroll), zat kimia otaknya terganggu secara
                                    drastis, memicu insomnia parah, delusi, dan
                                    depresi klinis akut.
                                </p>

                                <div
                                    class="bg-[#F0F4F1]/60 border border-slate-100 p-4 rounded-2xl space-y-2 relative"
                                >
                                    <div
                                        class="text-[#1E3E3F] font-fredoka font-bold text-xs flex items-center gap-2"
                                    >
                                        <span>🧠</span> Kerusakan Zat Kimia Otak &amp;
                                        Sakau Digital
                                    </div>
                                    <p
                                        class="text-slate-600 text-xs leading-relaxed"
                                    >
                                        Saat orang tua Selena membatasi
                                        ponselnya secara paksa, ia melarikan
                                        diri dan mengalami gejala kepanikan yang
                                        setara dengan penarikan zat adiktif
                                        (withdrawal symptoms). Rentetan paparan
                                        tanpa filter berujung tragis pada
                                        hilangnya jiwanya pada tahun 2021.
                                    </p>
                                </div>
                            </div>

                            <div class="pt-6">
                                <button
                                    data-case="selena"
                                    class="case-expand-btn w-full py-3.5 bg-[#F0F4F1] hover:bg-[#E2ECE9] text-[#1E3E3F] border border-slate-200 font-fredoka text-xs font-bold uppercase rounded-2xl transition-all duration-200"
                                >
                                    Pelajari Perjalanan Selena ➔
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ==========================================
        SECTION B: DATABASE VIEW (The Data Hub)
        ========================================== -->
            <section
                id="view-database"
                class="spa-view hidden transition-opacity duration-300"
            >
                <!-- Stats Header -->
                <div class="mb-12 space-y-3 text-center sm:text-left">
                    <div
                        class="inline-flex items-center gap-2 px-4 py-2 border border-slate-200 bg-[#F5C564]/10 rounded-full text-[#1E3E3F] font-fredoka text-sm font-bold shadow-sm"
                    >
                        <span
                            class="inline-block w-2.5 h-2.5 rounded-full bg-[#F5C564] animate-pulse"
                        ></span>
                        Matriks &amp; Riset Dampak Psikologis
                    </div>
                    <h3
                        class="font-fredoka text-4xl font-extrabold text-[#1E3E3F]"
                    >
                        THE DATA HUB
                    </h3>
                    <p
                        class="text-slate-500 text-lg max-w-3xl font-semibold leading-relaxed"
                    >
                        Menampilkan data kuantitatif dari <strong
                            class="text-[#1E3E3F]"
                            >Harvard STRIPED &amp; Michigan State University
                            (2023)</strong
                        >. Angka-angka ini mencerminkan sejauh mana manipulasi
                        platform memengaruhi psikologi generasi muda.
                    </p>
                </div>

                <!-- Big Statistic Cards (Clean Pastel Designs) -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
                    <!-- Card 1 -->
                    <div
                        class="bg-[#FFFDF9] rounded-3xl p-6 border border-slate-200/80 shadow-[0_8px_30px_rgba(0,0,0,0.03)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between"
                    >
                        <div class="space-y-4">
                            <div
                                class="flex justify-between items-center text-[#EE6C81]"
                            >
                                <span
                                    class="font-fredoka text-xs font-bold tracking-wider uppercase"
                                    >Valuasi Eksploitasi</span
                                >
                                <span class="text-lg">📈</span>
                            </div>
                            <h4
                                class="font-fredoka text-4xl sm:text-5xl font-extrabold text-[#1E3E3F] tracking-tight"
                            >
                                $11 Miliar
                            </h4>
                            <h5
                                class="font-fredoka text-md font-bold text-slate-700"
                            >
                                Ad Revenue dari Usia 0-17 Tahun
                            </h5>
                            <p
