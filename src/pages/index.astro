                        id: 9,
                        category: "TEKANAN PSIKIS",
                        text: "Apakah Anda merasa algoritma menyajikan konten yang memicu amarah atau kesedihan untuk membuat Anda tetap bertahan di aplikasi?",
                    },
                    {
                        id: 10,
                        category: "ADIKSI DOPAMIN",
                        text: "Apakah Anda sering mengabaikan tanggung jawab nyata (seperti belajar atau bekerja) demi terus menggulir feed?",
                    },
                    {
                        id: 11,
                        category: "TEKANAN PSIKIS",
                        text: "Seberapa sering Anda melihat konten diet ekstrem atau self-harm secara tidak sengaja di halaman rekomendasi Anda?",
                    },
                    {
                        id: 12,
                        category: "TEKANAN PSIKIS",
                        text: "Apakah Anda merasa interaksi digital membuat Anda merasa lebih terisolasi daripada terhubung secara nyata?",
                    },
                    {
                        id: 13,
                        category: "TEKANAN PSIKIS",
                        text: "Apakah suasana hati (mood) Anda sangat dipengaruhi oleh pasang surut interaksi di media sosial hari itu?",
                    },
                    {
                        id: 14,
                        category: "ADIKSI DOPAMIN",
                        text: "Apakah Anda merasa lelah secara emosional (digital burnout) namun tetap kesulitan menutup aplikasi media sosial Anda?",
                    },
                    {
                        id: 15,
                        category: "BYPASS PROTEKSI",
                        text: "Apakah Anda memanipulasi informasi profil atau usia Anda untuk mengakses fitur platform yang sebenarnya memicu kecemasan Anda?",
                    },
                ];

                let currentQuestionIdx = 0;
                const answers = Array(QUESTIONS.length).fill(0);

                const questText = document.getElementById(
                    "audit-question-text",
                );
                const categoryLabel = document.getElementById(
                    "audit-category-label",
                );
                const progressText = document.getElementById(
                    "audit-progress-text",
                );
                const progressPercent = document.getElementById(
                    "audit-progress-percent",
                );
                const progressBar =
                    document.getElementById("audit-progress-bar");
                const prevBtn = document.getElementById("audit-prev-btn");
                const optionsContainer = document.getElementById(
                    "audit-options-container",
                );
                const hoverLabelDisplay = document.getElementById(
                    "hover-label-display",
                );
                const submitBtnContainer = document.getElementById(
                    "submit-btn-container",
                );
                const auditSubmitBtn =
                    document.getElementById("audit-submit-btn");

                const questionnaireState = document.getElementById(
                    "audit-questionnaire-state",
                );
                const resultsState = document.getElementById(
                    "audit-results-state",
                );

                // RENDER ACTIVE QUESTION
                function renderQuestion() {
                    const question = QUESTIONS[currentQuestionIdx];
                    if (!question) return;

                    // Category styling helper
                    categoryLabel.textContent = `// KATEGORI: ${question.category}`;

                    // Set Question Text
                    questText.textContent = question.text;

                    // Update Progress text
                    const currentNum = currentQuestionIdx + 1;
                    progressText.textContent = `Pertanyaan ${currentNum.toString().padStart(2, "0")} dari ${QUESTIONS.length}`;

                    // Progress Bar and Percent
                    const percentVal = Math.round(
                        (currentQuestionIdx / QUESTIONS.length) * 100,
                    );
                    progressPercent.textContent = `${percentVal}% Selesai`;
                    progressBar.style.width = `${(currentNum / QUESTIONS.length) * 100}%`;

                    // Back Button visibility
                    prevBtn.disabled = currentQuestionIdx === 0;

                    // Hide submit container by default
                    submitBtnContainer.classList.add("hidden");

                    // Render 5 Rating Circles
                    optionsContainer.innerHTML = "";

                    const ratingLabels = [
                        "Sangat Jarang / Tidak Pernah",
                        "Jarang",
                        "Kadang-kadang",
                        "Sering",
                        "Sangat Sering / Selalu",
                    ];

                    const colorThemes = [
                        "hover:bg-[#8AE3C2]/20 hover:border-[#0D9488]",
                        "hover:bg-[#8AE3C2]/20 hover:border-[#0D9488]",
                        "hover:bg-[#F5C564]/20 hover:border-[#D97706]",
                        "hover:bg-[#F3A3B1]/20 hover:border-[#EE6C81]",
                        "hover:bg-[#EE6C81]/20 hover:border-[#EE6C81]",
                    ];

                    const activeThemes = [
                        "bg-[#8AE3C2]/40 border-[#0D9488] text-[#1E3E3F] scale-110",
                        "bg-[#8AE3C2]/40 border-[#0D9488] text-[#1E3E3F] scale-110",
                        "bg-[#F5C564]/40 border-[#D97706] text-[#1E3E3F] scale-110",
                        "bg-[#F3A3B1]/40 border-[#EE6C81] text-[#1E3E3F] scale-110",
                        "bg-[#EE6C81]/40 border-[#EE6C81] text-white scale-110",
                    ];

                    for (let i = 1; i <= 5; i++) {
                        const btn = document.createElement("button");
                        const isSelected = answers[currentQuestionIdx] === i;

                        btn.className = `w-14 h-14 rounded-full border-3 border-[#1E3E3F] flex items-center justify-center text-lg font-bold font-fredoka transition-all duration-200 ${
                            isSelected
                                ? activeThemes[i - 1]
                                : `bg-[#FFFDF9] ${colorThemes[i - 1]} text-[#1E3E3F]`
                        }`;

                        btn.innerHTML = `${i}`;

                        // Hover shows descriptions
                        btn.addEventListener("mouseenter", () => {
                            hoverLabelDisplay.textContent = `Skala ${i}: ${ratingLabels[i - 1]}`;
                            hoverLabelDisplay.className =
                                "font-fredoka font-bold text-sm text-[#1E3E3F] transition-colors h-6 bg-[#FAF5FF] px-4 py-0.5 rounded-full border border-[#1E3E3F]/10";
                        });

                        btn.addEventListener("mouseleave", () => {
                            hoverLabelDisplay.textContent =
                                "Sentuh nomor untuk melihat deskripsi skala";
                            hoverLabelDisplay.className =
                                "font-fredoka font-bold text-sm text-slate-500 transition-colors h-6 bg-slate-50 px-4 py-0.5 rounded-full border border-slate-100";
                        });

                        // Click logic
                        btn.addEventListener("click", () => {
                            answers[currentQuestionIdx] = i;
                            playSound("click");

                            setTimeout(() => {
                                if (currentQuestionIdx < QUESTIONS.length - 1) {
                                    currentQuestionIdx++;
                                    renderQuestion();
                                } else {
                                    // Redraw to show selection on 15th question, then show submit button
                                    renderQuestion();
                                    submitBtnContainer.classList.remove(
                                        "hidden",
                                    );
                                }
                            }, 250);
                        });

                        optionsContainer.appendChild(btn);
                    }

                    // If it's the last question and it has been answered, make sure to show submit button
                    if (
                        currentQuestionIdx === QUESTIONS.length - 1 &&
                        answers[currentQuestionIdx] !== 0
                    ) {
                        submitBtnContainer.classList.remove("hidden");
                    }
                }

                // SUBMIT BUTTON EVENT (Fase 1 to Fase 2 transition)
                auditSubmitBtn.addEventListener("click", () => {
                    calculateAuditResults();
                });

                // PREVIOUS BUTTON EVENT
                prevBtn.addEventListener("click", () => {
                    if (currentQuestionIdx > 0) {
                        playSound("click");
                        currentQuestionIdx--;
                        renderQuestion();
                    }
                });

                // CALCULATE RESULT SCORING & UNLOCK CHATBOT (STRICT CONDITIONAL LOGIC)
                function calculateAuditResults() {
                    playSound("success");

                    // Update status indicator
                    if (threatIndicator) {
                        threatIndicator.textContent =
                            "STATUS: MEREKAP HASIL AUDIT";
                        threatIndicator.className =
                            "text-[#EE6C81] font-bold animate-pulse";
                    }

                    // Compute scores
                    const totalScore = answers.reduce(
                        (sum, score) => sum + score,
                        0,
                    );

                    // Categories maps
                    let bodyImageScore = 0; // max 20 (Q2, Q7, Q11, Q14)
                    let addictionScore = 0; // max 25 (Q1, Q4, Q6, Q10, Q14)
                    let covertScore = 0; // max 10 (Q3, Q15)
                    let distressScore = 0; // max 20 (Membahas Q5, Q8, Q9, Q12, Q13)

                    QUESTIONS.forEach((q, idx) => {
                        const score = answers[idx];
                        if (q.category === "CITRA TUBUH")
                            bodyImageScore += score;
                        else if (q.category === "ADIKSI DOPAMIN")
                            addictionScore += score;
                        else if (q.category === "BYPASS PROTEKSI")
                            covertScore += score;
                        else if (q.category === "TEKANAN PSIKIS")
                            distressScore += score;
                    });

                    // Compute percentages dynamically
                    const bodyImagePct = Math.round(
                        (bodyImageScore / 15) * 100,
                    );
                    const addictionPct = Math.round(
                        (addictionScore / 25) * 100,
                    );
                    const covertPct = Math.round((covertScore / 10) * 100);
                    const distressPct = Math.round((distressScore / 25) * 100);

                    // Update Category Details on DOM
                    document.getElementById(
                        "index-body-image-val",
                    ).textContent = `${Math.min(bodyImagePct, 100)}%`;
                    document.getElementById(
                        "index-body-image-bar",
                    ).style.width = `${Math.min(bodyImagePct, 100)}%`;

                    document.getElementById("index-addiction-val").textContent =
                        `${Math.min(addictionPct, 100)}%`;
                    document.getElementById("index-addiction-bar").style.width =
                        `${Math.min(addictionPct, 100)}%`;

                    document.getElementById("index-covert-val").textContent =
                        `${Math.min(covertPct, 100)}%`;
                    document.getElementById("index-covert-bar").style.width =
                        `${Math.min(covertPct, 100)}%`;

                    document.getElementById("index-distress-val").textContent =
                        `${Math.min(distressPct, 100)}%`;
                    document.getElementById("index-distress-bar").style.width =
                        `${Math.min(distressPct, 100)}%`;

                    // Risk level determination
                    let riskBadgeText = "";
                    let riskTitleText = "";
                    let riskDescText = "";
                    let riskColorClass = "";
                    let riskGlowClass = "";
                    let threatLevel = "";

                    if (totalScore <= 35) {
                        riskBadgeText = "RISIKO RENDAH // DIGITAL RESILIENT";
                        riskTitleText =
                            "Kestabilan Kognitif: Baik (Resiliensi)";
                        riskDescText =
                            "Luar biasa. Pola perilaku Anda menunjukkan batas sehat antara kehidupan nyata dan stimulus digital. Sirkuit dopamin Anda memiliki kontrol yang kuat dan tidak mudah dimanipulasi oleh taktik infinite scroll.";
                        riskColorClass =
                            "bg-[#8AE3C2]/20 text-[#0D9488] border-[#8AE3C2]";
                        riskGlowClass = "#0D9488";
                        threatLevel = "STATUS: KESEHATAN PIKIRAN AMAN";
                    } else if (totalScore <= 55) {
                        riskBadgeText = "RISIKO SEDANG // DIGITAL VULNERABLE";
                        riskTitleText = "Kestabilan Kognitif: Sedang (Rentan)";
                        riskDescText =
                            "Perlu perhatian. Algoritma media sosial mulai mengintervensi sirkuit penghargaan otak Anda. Anda mulai membandingkan fisik dan pencapaian Anda secara negatif, serta mengalami gangguan tidur minor.";
                        riskColorClass =
                            "bg-[#F5C564]/20 text-[#D97706] border-[#F5C564]/60";
                        riskGlowClass = "#D97706";
                        threatLevel = "STATUS: DETEKSI KECEMASAN SEDANG";
                    } else {
                        riskBadgeText = "RISIKO TINGGI // CRITICAL EXPOSURE";
                        riskTitleText = "Kestabilan Kognitif: Rendah (Krisis)";
                        riskDescText =
                            "Bahaya. Paparan manipulasi algoritma telah membajak sirkuit atensi dan dopamin Anda secara kronis. Anda mengalami gejala kecemasan hebat, body dysmorphia, insomnia, dan digital burnout yang parah.";
                        riskColorClass =
                            "bg-[#EE6C81]/20 text-[#EE6C81] border-[#EE6C81]/60 font-bold";
                        riskGlowClass = "#EE6C81";
                        threatLevel = "STATUS: PERLU INTERVENSI PSIKOLOGIS";
                    }

                    // Update Score text
                    document.getElementById("result-score-text").textContent =
                        totalScore;

                    const badge = document.getElementById("result-risk-badge");
                    badge.textContent = riskBadgeText;
                    badge.className = `inline-block px-4 py-1.5 font-fredoka text-xs font-bold uppercase tracking-wide rounded-full border border-slate-200 ${riskColorClass}`;

                    document.getElementById("result-risk-title").textContent =
                        riskTitleText;
                    document.getElementById(
                        "result-risk-description",
                    ).textContent = riskDescText;

                    // Update Donut Chart Ring
                    const circle = document.getElementById("result-svg-circle");
                    const maxCircumference = 251.2;
                    const offset =
                        maxCircumference - (totalScore / 75) * maxCircumference;

                    circle.style.strokeDashoffset = offset;
                    circle.setAttribute("stroke", riskGlowClass);

                    // Update Pulse Icon border & status color
                    const pulseIcon =
                        document.getElementById("result-pulse-icon");
                    pulseIcon.style.borderColor = riskGlowClass;
                    pulseIcon.style.backgroundColor = `${riskGlowClass}22`;

                    if (threatIndicator) {
                        threatIndicator.textContent = threatLevel;
                        if (totalScore <= 35) {
                            threatIndicator.className =
                                "text-[#8AE3C2] font-bold";
                        } else if (totalScore <= 55) {
                            threatIndicator.className =
                                "text-[#F5C564] font-bold";
                        } else {
                            threatIndicator.className =
                                "text-[#EE6C81] font-bold animate-pulse";
                        }
                    }

                    // Transition views & Unlock chatbot
                    questionnaireState.classList.add("hidden");
                    resultsState.classList.remove("hidden");
                }

                // RESET AUDIT QUIZ BUTTON EVENT
                document
                    .getElementById("audit-reset-btn")
                    .addEventListener("click", () => {
                        playSound("reset");
                        currentQuestionIdx = 0;
                        answers.fill(0);

                        resultsState.classList.add("hidden");
                        questionnaireState.classList.remove("hidden");

                        if (threatIndicator) {
                            threatIndicator.textContent =
                                "STATUS: PIKIRAN STABIL";
                            threatIndicator.className =
                                "text-[#8AE3C2] font-bold";
                        }

                        renderQuestion();
                    });

                // Initial Questionnaire render
                renderQuestion();

                // Check URL query parameters to activate the correct tab on page load
                const urlParams = new URLSearchParams(window.location.search);
                const tabParam = urlParams.get("tab");
                if (
                    tabParam &&
                    ["home", "database", "scanning"].includes(tabParam)
                ) {
                    const btn = document.getElementById(`tab-btn-${tabParam}`);
                    if (btn) btn.click();
                }
            });
        </script>
    </body>
</html>
